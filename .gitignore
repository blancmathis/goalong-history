.DS_Store
.build/
.swiftpm/
dist/
*.xcuserstate
.sparkle-private-key*

# Isolated user-journey QA outputs; never personal app data.
qa/journey/
qa/journey-ci/
# Gallery runs (make gallery); the base lives in ~/Library/Caches/goalong-gallery.
qa/gallery/

# Python validation caches are not source modifications in release inventories.
__pycache__/
*.py[cod]

# Private Ambiance measurements and pack preparation.
.ambiance-work/

# Brand-motion probe output (CI uploads it; a local run writes to a temporary folder).
qa/brand-motion/
