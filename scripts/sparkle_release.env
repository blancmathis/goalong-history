# Central Sparkle release configuration. Keep Package.swift pinned to the same version.
SPARKLE_VERSION="2.9.6"
SPARKLE_PACKAGE_URL="https://github.com/sparkle-project/Sparkle"
# Every merge to main publishes a signed rolling release under this stable tag. The URL does
# not change, so installed apps can discover the newest Git state immediately.
SPARKLE_FEED_URL="https://github.com/blancmathis/goalong-history/releases/download/latest-main/appcast.xml"
SPARKLE_RELEASE_DOWNLOAD_ROOT="https://github.com/blancmathis/goalong-history/releases/download"
SPARKLE_KEY_ACCOUNT="goalong-localhistory"
